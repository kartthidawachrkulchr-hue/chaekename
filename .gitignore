*.doc
*.docx
*.txt
*.pdf
*.xls
*.xlsx
*.csv

# Google Apps Script & Secrets
*.gs
*.env
*.env.*
*.pem
*.key
credentials.json
client_secret.json
backend_config.md

# Logs and Databases
*.log
*.sqlite
*.db
node_modules/
.DS_Store